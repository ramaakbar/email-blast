{
  "plugins": [
    "react",
    "typescript",
    "unicorn"
  ],
  "categories": {
    "correctness": "error",
    "suspicious": "warn",
    "perf": "warn"
  },
  "rules": {
    "react/react-in-jsx-scope": "off"
  },
  "ignorePatterns": [
    "out",
    "dist",
    "src/renderer/src/routeTree.gen.ts",
    "src/paraglide"
  ]
}
