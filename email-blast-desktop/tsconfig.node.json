{
  "extends": "@electron-toolkit/tsconfig/tsconfig.node.json",
  "include": [
    "forge.config.*",
    "vitest.config.ts",
    "src/main/**/*",
    "src/preload/**/*",
    "src/shared/**/*",
    "src/paraglide/**/*"
  ],
  "compilerOptions": {
    "composite": true,
    "baseUrl": ".",
    "paths": {
      "@paraglide/*": ["src/paraglide/*"]
    }
  }
}
